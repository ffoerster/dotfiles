encryption = "age"

# ─────────────────────────────────────────────────────
# OS Detection
# ─────────────────────────────────────────────────────
# Determine OS ID for conditional includes
{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}
{{- if hasKey .chezmoi.osRelease "idLike" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.idLike -}}
{{- end -}}

# ─────────────────────────────────────────────────────
# Machine Type Detection
# ─────────────────────────────────────────────────────
# Prompt for machine characteristics on first run
{{- $is_work := false -}}
{{- $is_personal := false -}}
{{- $is_vm := false -}}

{{- if stdinIsATTY -}}
{{-   $is_work = promptBoolOnce . "is_work" "Is this a work machine" -}}
{{-   $is_personal = not $is_work -}}
{{-   $is_vm = promptBoolOnce . "is_vm" "Is this a VM or container" -}}
{{- else -}}
{{-   $is_work = false -}}
{{-   $is_personal = true -}}
{{-   $is_vm = false -}}
{{- end -}}

# ─────────────────────────────────────────────────────
# Encryption Configuration
# ─────────────────────────────────────────────────────
[age]
  identity = "~/.config/chezmoi/key.txt"
  recipient = "age1cl8mg4krjvyuk3syzk8jsqk095gnx7tnuxlrup3nsm9nhwtehezssu0nv0"

# ─────────────────────────────────────────────────────
# Tool Integration
# ─────────────────────────────────────────────────────
[onepassword]
    mode = "account"

[edit]
    command = "code"
    args = ["--wait"]

# ─────────────────────────────────────────────────────
# Template Variables
# ─────────────────────────────────────────────────────
[data]
    osid = {{ $osid | quote }}
    is_work = {{ $is_work }}
    is_personal = {{ $is_personal }}
    is_vm = {{ $is_vm }}

# Run a script to install password manager CLI before reading source state
[hooks.read-source-state.pre]
{{- if eq .chezmoi.os "windows" }}
command = "powershell"
args = ["{{ .chezmoi.sourceDir }}/.chezmoiscripts/windows/.install-password-manager.ps1"]
{{- else if eq .chezmoi.os "darwin" }}
command = "{{ .chezmoi.sourceDir }}/.chezmoiscripts/darwin/.install-password-manager.sh"
{{ else }}
command = "{{ .chezmoi.sourceDir }}/.chezmoiscripts/linux/.install-password-manager.sh"
{{ end -}}
