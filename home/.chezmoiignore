# ─────────────────────────────
# Generic OS / tooling cruft
# ─────────────────────────────
.DS_Store
node_modules
.trunk
.vscode
**/*.src.ini

# Project / repo files not needed in chezmoi
README.md
Packages.md
.assets       # used to save symlink destination files
key.txt.age
.cspell.json
.editorconfig
.gitignore
.prettierrc.json
package*.json

# ─────────────────────────────
# Zsh & shell: history, caches, dumps
# ─────────────────────────────
# Zsh completion dump (constantly rewritten by compinit)
.zcompdump*
# Zsh history variants
.zsh_history*
.zhistory*
# Zsh per-session history (if enabled)
.zsh_sessions/**
# Other typical shell / REPL histories
.bash_history
.lesshst
.python_history
.sqlite_history

# ─────────────────────────────
# OS-specific ignores
# Manage files that have different locations on different machines
# https://www.chezmoi.io/user-guide/manage-machine-to-machine-differences/#ignore-files-or-a-directory-on-different-machines
# ─────────────────────────────

{{ if ne .chezmoi.os "darwin" }}
Library/Application Support
Library
.config/applications
{{ end }}

{{ if ne .chezmoi.os "linux" }}
.chezmoiscripts/linux/**
dot_bashrc
dot_config
dot_local
{{ end }}

{{ if ne .chezmoi.os "windows" }}
.chezmoiscripts/windows/**
readonly_Documents/PowerShell/**
readonly_Documents/WindowsPowerShell/**
readonly_Documents/PowerShell/Microsoft.PowerShell_profile.ps1
readonly_Documents/WindowsPowerShell/Microsoft.PowerShell_profile.ps1
{{ end }}

{{ if ne .osid "linux-arch" }}
dot_config/paru/**
.chezmoiscripts/linux/arch/**
.chezmoidata/packages/linux/arch.yaml
{{ end }}

{{ if and (ne .osid "linux-debian") (ne .osid "linux-ubuntu") (ne .osid "linux-debian ubuntu") (ne .osid "linux-ubuntu debian") }}
.chezmoiscripts/linux/debian/**
.chezmoidata/packages/linux/debian.yaml
{{ end }}

# ─────────────────────────────
# Work vs Personal machine ignores
# ─────────────────────────────
{{ if .is_work }}
# Ignore personal-only configs on work machines
.config/personal/**
dot_config/personal/**
{{ else }}
# Ignore work-only configs on personal machines
.config/work/**
dot_config/work/**
{{ end }}

# ─────────────────────────────
# VM-specific ignores
# ─────────────────────────────
{{ if .is_vm }}
# Ignore GUI apps and desktop configs on VMs
.config/alacritty/**
.config/kitty/**
.config/wezterm/**
Library/**
Applications/**
.local/share/fonts/**
Library/Fonts/**
dot_local/share/fonts/**
private_dot_local/share/fonts/**
private_Library/Fonts/**

# Ignore resource-heavy tools on VMs
.config/docker/  # If not doing development
{{ else }}
# Ignore VM-only optimizations on bare metal
.config/vm-optimizations/**
{{ end }}
