# =============================================================================
# ZSH CONFIGURATION FILE
# =============================================================================
# This file is managed by chezmoi - changes will be applied to ~/.zshrc
# Last updated: November 12, 2025

# =============================================================================
# CONFIGURATION VARIABLES
# =============================================================================
# Define paths and settings for better portability across systems
export ZSH_CONFIG_DIR="${HOME}/.zsh"
export BREW_PREFIX="$(brew --prefix 2>/dev/null || echo /usr/local)"
export USER_BIN_DIR="${HOME}/.local/bin"

# Fix for GPG TTY issues in terminals
export GPG_TTY="$(tty)"


# =============================================================================
# COMPLETION SETUP
# =============================================================================
# Add deno completions to zsh function path
if [[ ":$FPATH:" != *":${ZSH_CONFIG_DIR}/completions:"* ]]; then
  export FPATH="${ZSH_CONFIG_DIR}/completions:$FPATH"
fi

# =============================================================================
# OH-MY-ZSH CONFIGURATION
# =============================================================================
# Path to oh-my-zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Theme selection (set to "random" for random theme on each load)
ZSH_THEME="robbyrussell"

# Random theme candidates (only used when ZSH_THEME="random")
# ZSH_THEME_RANDOM_CANDIDATES=( "robbyrussell" "agnoster" )

# Completion settings
# CASE_SENSITIVE="true"      # Case-sensitive completion
# HYPHEN_INSENSITIVE="true"  # Treat - and _ as equivalent

# Update behavior
# zstyle ':omz:update' mode disabled  # Disable updates
# zstyle ':omz:update' mode auto      # Auto-update
# zstyle ':omz:update' mode reminder  # Remind to update

# Other options
# DISABLE_MAGIC_FUNCTIONS="true"     # Fix URL pasting issues
# DISABLE_LS_COLORS="true"           # Disable ls colors
# DISABLE_AUTO_TITLE="true"          # Disable auto terminal title
# ENABLE_CORRECTION="true"           # Enable command correction
# COMPLETION_WAITING_DOTS="true"     # Show dots while waiting for completion
# DISABLE_UNTRACKED_FILES_DIRTY="true"  # Speed up git status in large repos

# History timestamp format
# HIST_STAMPS="mm/dd/yyyy"  # Options: mm/dd/yyyy, dd.mm.yyyy, yyyy-mm-dd

# Custom folder for oh-my-zsh extensions
# ZSH_CUSTOM=/path/to/new-custom-folder

# Plugins to load (standard plugins in $ZSH/plugins/, custom in $ZSH_CUSTOM/plugins/)
plugins=(git)

# Load oh-my-zsh
source $ZSH/oh-my-zsh.sh

# =============================================================================
# ZSH PLUGINS
# =============================================================================
# Fast syntax highlighting (must load after oh-my-zsh, before autosuggestions)
source "${BREW_PREFIX}/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"

# Autosuggestions (must load after syntax highlighting)
source "${BREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# Configure syntax highlighting colors (optional - uncomment to customize)
# ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets pattern cursor)
# ZSH_HIGHLIGHT_STYLES[command]='fg=green,bold'           # Valid commands
# ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=red,bold'       # Invalid commands
# ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=yellow'         # Reserved words
# ZSH_HIGHLIGHT_STYLES[alias]='fg=blue'                   # Aliases
# ZSH_HIGHLIGHT_STYLES[builtin]='fg=blue,bold'            # Built-in commands
# ZSH_HIGHLIGHT_STYLES[function]='fg=blue'                # Functions
# ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=yellow'      # Command separators
# ZSH_HIGHLIGHT_STYLES[redirection]='fg=magenta'          # Redirections
# ZSH_HIGHLIGHT_STYLES[globbing]='fg=magenta,bold'        # Globbing

# =============================================================================
# MODERN ZSH OPTIONS
# =============================================================================
# Enhanced history behavior
setopt HIST_IGNORE_ALL_DUPS  # Remove duplicate entries from history
setopt HIST_FIND_NO_DUPS     # Don't show duplicates when searching history
setopt INC_APPEND_HISTORY    # Append to history immediately
setopt EXTENDED_HISTORY      # Save timestamp and duration

# Better completion behavior
setopt MENU_COMPLETE         # Insert first match immediately on tab
setopt AUTO_CD               # Change directory without cd command
setopt CORRECT               # Try to correct spelling
setopt COMPLETE_IN_WORD      # Complete from both ends of word

# =============================================================================
# USER CONFIGURATION
# =============================================================================
# Uncomment to customize:
# export MANPATH="/usr/local/man:$MANPATH"     # Add to manual pages path
# export LANG=en_US.UTF-8                      # Set language environment
# export ARCHFLAGS="-arch x86_64"              # Compilation flags

# =============================================================================
# ALIASES
# =============================================================================

# Tools
alias x="exit"
alias tmux_work='tmuxp load ~/.config/tmux/tmuxp-work.yml'

# Force color terminal for SSH connections
alias ssh="TERM=xterm-256color ssh"
# Override oh-my-zsh defaults
alias zshconfig='micro ~/.zshrc'  # Edit zshrc with micro editor
alias cat='bat --paging=never'    # Use bat instead of cat (with no paging)
alias ls='lsd'                    # Use lsd instead of ls (prettier directory listing)

# Navigation shortcuts
alias home="cd ~"                 # Go to home directory
alias ..="cd .."                  # Go up 1 directory
alias ...='cd ../..'              # Go up 2 directories
alias ....='cd ../../..'          # Go up 3 directories
alias .....='cd ../../../..'      # Go up 4 directories

# Git shortcuts
alias gs='git status'             # Show git status
alias ga='git add'                # Stage files
alias gc='git commit'             # Commit changes
alias gp='git push'               # Push to remote
alias gl='git log --oneline'      # Show concise commit history
alias gd='git diff'               # Show unstaged changes
alias gco='git checkout'          # Switch branches/tags

# System information
alias myip='curl https://ipinfo.io/'  # Get public IP
alias localip='ipconfig getifaddr en0 2>/dev/null || ip route get 1 | awk "{print \$7}"'  # Get local IP
alias ports='netstat -tulanp'     # Show open ports

# Safe file operations (prompt before overwrite/delete)
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'
alias mkdir='mkdir -p'            # Create parent directories as needed

# Process management
alias psa='ps aux'                # Show all processes
alias psg='ps aux | grep'         # Search processes

# Docker shortcuts
alias dps='docker ps'             # List running containers
alias dcp='docker compose pull'  # Pull compose services
alias dcu='docker compose up -d --remove-orphans'  # Start compose services in background
alias dcd='docker compose down'   # Stop compose services

# Use eza for long listings if available
if [[ -f /usr/bin/eza ]]; then
  alias ll="eza -l --icons=always --color=always"
  alias la="eza -la --icons=always --color=always"
fi


# =============================================================================
# INITIALIZERS
# =============================================================================
# =============================================================================
# SHELL ENHANCEMENTS
# =============================================================================
# Starship prompt (minimal, fast, customizable prompt)
eval "$(starship init zsh)"

# Zoxide (smarter cd command with frecency-based directory tracking)
eval "$(zoxide init zsh)"

# =============================================================================
# COMPLETION & EXTENSIONS
# =============================================================================
# Load custom completion configuration
[ -f "${ZSH_CONFIG_DIR}/completion.zsh" ] && source "${ZSH_CONFIG_DIR}/completion.zsh"

# Enhanced menu completion
zmodload -i zsh/complist

# Load additional zsh configurations
[ -f "${ZSH_CONFIG_DIR}/history.zsh" ] && source "${ZSH_CONFIG_DIR}/history.zsh"
[ -f "${ZSH_CONFIG_DIR}/key-bindings.zsh" ] && source "${ZSH_CONFIG_DIR}/key-bindings.zsh"
[ -f "${ZSH_CONFIG_DIR}/aliases.zsh" ] && source "${ZSH_CONFIG_DIR}/aliases.zsh"

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Bun (fast JavaScript runtime and package manager)
[ -s "${HOME}/.bun/_bun" ] && source "${HOME}/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Homebrew Ruby (add to PATH if installed)
if [ -d "/opt/homebrew/opt/ruby/bin" ]; then
  export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
  export PATH="$(gem environment gemdir)/bin:$PATH"
fi

# Lando (local development environment)
export PATH="${HOME}/.lando/bin${PATH+:$PATH}"

# pnpm (performant npm)
export PNPM_HOME="${HOME}/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Deno (secure runtime for JavaScript and TypeScript)
[ -f "${HOME}/.deno/env" ] && . "${HOME}/.deno/env"

# fnm (Fast Node Manager - Node.js version manager)
FNM_PATH="${HOME}/Library/Application Support/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="${FNM_PATH}:$PATH"
  eval "$(fnm env)"
fi
eval "$(fnm env --use-on-cd --shell zsh)"

# Rust (Cargo package manager)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Atuin (improved shell history)
[ -f "$HOME/.atuin/bin/env" ] && . "$HOME/.atuin/bin/env"
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh)"

# Python version manager
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init -)"

# pipx (install Python applications in isolated environments)
export PATH="$PATH:${USER_BIN_DIR}"

# =============================================================================
# DOCKER COMPLETIONS
# =============================================================================
# Docker CLI completions (added by Docker Desktop)
fpath=("${HOME}/.docker/completions" $fpath)
autoload -Uz compinit
compinit
