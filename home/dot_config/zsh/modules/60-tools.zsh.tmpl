# ============================================================================
# TOOL INITIALIZATIONS
# ============================================================================
# Initialize development tools and CLIs

# ============================================================================
# STARSHIP PROMPT
# ============================================================================
# Modern, minimal, fast prompt
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# ============================================================================
# ZOXIDE
# ============================================================================
# Smarter cd command with frecency-based directory tracking
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

# ============================================================================
# FZF
# ============================================================================
# Fuzzy finder
if command -v fzf >/dev/null 2>&1; then
    # Auto-completion
    [[ $- == *i* ]] && source "${BREW_PREFIX}/opt/fzf/shell/completion.zsh" 2> /dev/null

    # Key bindings
    source "${BREW_PREFIX}/opt/fzf/shell/key-bindings.zsh" 2> /dev/null

    # Use fd for file search if available
    if command -v fd >/dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
    fi

    # Preview with bat
    if command -v bat >/dev/null 2>&1; then
        export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :50 {}'"
    fi
fi

# ============================================================================
# NODE VERSION MANAGER (fnm)
# ============================================================================
# Fast Node Manager
if command -v fnm >/dev/null 2>&1; then
{{ if eq .chezmoi.os "darwin" }}
    export FNM_PATH="${HOME}/Library/Application Support/fnm"
{{ else }}
    export FNM_PATH="${HOME}/.local/share/fnm"
{{ end }}

    if [ -d "$FNM_PATH" ]; then
        export PATH="${FNM_PATH}:$PATH"
    fi

    eval "$(fnm env --use-on-cd --shell zsh)"
fi

# ============================================================================
# PYTHON (pyenv)
# ============================================================================
# Python version manager
if command -v pyenv >/dev/null 2>&1; then
    export PYENV_ROOT="$HOME/.pyenv"

    if [[ -d $PYENV_ROOT/bin ]]; then
        export PATH="$PYENV_ROOT/bin:$PATH"
    fi

    eval "$(pyenv init --path)"
    eval "$(pyenv init -)"

    # pyenv-virtualenv
    if command -v pyenv-virtualenv-init >/dev/null 2>&1; then
        eval "$(pyenv virtualenv-init -)"
    fi
fi

# ============================================================================
# RUST (Cargo)
# ============================================================================
# Rust package manager
if [ -f "$HOME/.cargo/env" ]; then
    source "$HOME/.cargo/env"
fi

# ============================================================================
# BUN
# ============================================================================
# Fast JavaScript runtime
if [ -d "$HOME/.bun" ]; then
    export BUN_INSTALL="$HOME/.bun"
    export PATH="$BUN_INSTALL/bin:$PATH"

    # Bun completions
    [ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
fi

# ============================================================================
# DENO
# ============================================================================
# Secure runtime for JavaScript and TypeScript
if [ -d "$HOME/.deno" ]; then
    export DENO_INSTALL="$HOME/.deno"
    export PATH="$DENO_INSTALL/bin:$PATH"

    # Deno completions
    [ -f "$HOME/.deno/env" ] && source "$HOME/.deno/env"
fi

# ============================================================================
# PNPM
# ============================================================================
# Performant npm
if [[ -n "${PNPM_HOME:-}" ]]; then
    :
elif [ -d "${HOME}/.local/share/pnpm" ]; then
    export PNPM_HOME="${HOME}/.local/share/pnpm"
elif [ -d "${HOME}/Library/pnpm" ]; then
    export PNPM_HOME="${HOME}/Library/pnpm"
elif [ -n "${XDG_DATA_HOME:-}" ]; then
    export PNPM_HOME="${XDG_DATA_HOME}/pnpm"
else
    export PNPM_HOME="${HOME}/.local/share/pnpm"
fi

case ":$PATH:" in
    *":$PNPM_HOME:"*) ;;
    *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# ============================================================================
# RUBY (Homebrew)
# ============================================================================
{{ if eq .chezmoi.os "darwin" }}
if [ -d "${BREW_PREFIX}/opt/ruby/bin" ]; then
    export PATH="${BREW_PREFIX}/opt/ruby/bin:$PATH"

    # Add gem binaries to PATH
    if command -v gem >/dev/null 2>&1; then
        export PATH="$(gem environment gemdir)/bin:$PATH"
    fi
fi
{{ end }}

# ============================================================================
# LANDO
# ============================================================================
# Local development environment
if [ -d "$HOME/.lando/bin" ]; then
    export PATH="$HOME/.lando/bin:$PATH"
fi

# ============================================================================
# ATUIN
# ============================================================================
# Improved shell history
if command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init zsh)"
fi

# ============================================================================
# DIRENV
# ============================================================================
# Per-directory environment variables
if command -v direnv >/dev/null 2>&1; then
    eval "$(direnv hook zsh)"
fi

# ============================================================================
# TRY
# ============================================================================
# Per-directory development environment switching
if command -v try >/dev/null 2>&1; then
    eval "$(try init "$HOME/Projects/Tries")"
fi

# ============================================================================
# DOCKER
# ============================================================================
# Docker completions
if [ -d "$HOME/.docker/completions" ]; then
    fpath=("$HOME/.docker/completions" $fpath)
fi

# ============================================================================
# GITHUB CLI
# ============================================================================
# GitHub CLI completions
if command -v gh >/dev/null 2>&1; then
    eval "$(gh completion -s zsh)"
fi

# ============================================================================
# TERRAFORM
# ============================================================================
# Terraform completions
if command -v terraform >/dev/null 2>&1; then
    autoload -U +X bashcompinit && bashcompinit
    complete -o nospace -C $(which terraform) terraform
fi

# ============================================================================
# KUBECTL
# ============================================================================
# Kubernetes CLI completions
if command -v kubectl >/dev/null 2>&1; then
    source <(kubectl completion zsh)
fi

# ============================================================================
# CUSTOM COMPLETIONS
# ============================================================================
# Load custom completions from config directory
# Note: compinit is already called by Zim's completion module
if [ -d "${ZDOTDIR}/completions" ]; then
    fpath=("${ZDOTDIR}/completions" $fpath)
fi

# ============================================================================
# MISE
# ============================================================================
if [ -x "${BREW_PREFIX}/bin/mise" ]; then
    export MISE_BIN="${BREW_PREFIX}/bin/mise"
elif [ -n "$(whence -p mise 2>/dev/null)" ]; then
    export MISE_BIN="$(whence -p mise)"
fi

if [ -n "${MISE_BIN:-}" ] && [ -x "$MISE_BIN" ]; then
    export MISE_SHELL=zsh
    if [ -z "${__MISE_ORIG_PATH:-}" ]; then
        export __MISE_ORIG_PATH="$PATH"
    fi
    export __MISE_ZSH_PRECMD_RUN=0
    export __MISE_ZSH_CHPWD_RAN=0

    _mise_eval() {
        local output status
        output="$(command "$MISE_BIN" "$@")"
        status=$?

        if [ $status -eq 0 ] && [ -n "$output" ]; then
            eval "$output"
        fi

        return $status
    }

    mise() {
        local command
        command="${1:-}"
        if [ "$#" = 0 ]; then
            command "$MISE_BIN"
            return
        fi
        shift

        case "$command" in
        deactivate|shell|sh)
            if [[ ! " $* " =~ " --help " ]] && [[ ! " $* " =~ " -h " ]]; then
                _mise_eval "$command" "$@"
                return $?
            fi
            ;;
        esac
        command "$MISE_BIN" "$command" "$@"
    }

    autoload -Uz add-zsh-hook
    _mise_hook() {
        _mise_eval hook-env -s zsh
    }
    _mise_hook_precmd() {
        if [[ "${__MISE_ZSH_CHPWD_RAN:-0}" == "1" ]]; then
            export __MISE_ZSH_CHPWD_RAN=0
            return
        fi
        _mise_eval hook-env -s zsh --reason precmd
    }
    _mise_hook_chpwd() {
        export __MISE_ZSH_CHPWD_RAN=1
        _mise_eval hook-env -s zsh --reason chpwd
    }
    add-zsh-hook -d precmd _mise_hook_precmd 2>/dev/null
    add-zsh-hook -d chpwd _mise_hook_chpwd 2>/dev/null
    add-zsh-hook precmd _mise_hook_precmd
    add-zsh-hook chpwd _mise_hook_chpwd

    _mise_hook
    if [ -z "${_mise_cmd_not_found:-}" ]; then
        _mise_cmd_not_found=1

        if (( ${+functions[command_not_found_handler]} )) && (( ! ${+functions[_command_not_found_handler]} )); then
            functions[_command_not_found_handler]="${functions[command_not_found_handler]}"
        fi

        function command_not_found_handler() {
            local missing_command
            missing_command="$1"

            if [[ -n "$missing_command" && "$missing_command" != "mise" && "$missing_command" != "mise-"* ]] && command "$MISE_BIN" hook-not-found -s zsh -- "$missing_command"; then
                _mise_hook
                "$@"
            elif (( ${+functions[_command_not_found_handler]} )); then
                _command_not_found_handler "$@"
            else
                echo "zsh: command not found: $missing_command" >&2
                return 127
            fi
        }
    fi
fi
