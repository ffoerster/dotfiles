# ============================================================================
# TOOL INITIALIZATIONS
# ============================================================================
# Initialize development tools and CLIs

# ============================================================================
# STARSHIP PROMPT
# ============================================================================
# Modern, minimal, fast prompt
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi

# ============================================================================
# ZOXIDE
# ============================================================================
# Smarter cd command with frecency-based directory tracking
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

# ============================================================================
# FZF
# ============================================================================
# Fuzzy finder
if command -v fzf >/dev/null 2>&1; then
    # Auto-completion
    [[ $- == *i* ]] && source "${BREW_PREFIX}/opt/fzf/shell/completion.bash" 2> /dev/null

    # Key bindings
    source "${BREW_PREFIX}/opt/fzf/shell/key-bindings.bash" 2> /dev/null

    # Use fd for file search if available
    if command -v fd >/dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
    fi

    # Preview with bat
    if command -v bat >/dev/null 2>&1; then
        export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :50 {}'"
    fi
fi

# ============================================================================
# NODE VERSION MANAGER (fnm)
# ============================================================================
# Fast Node Manager
if command -v fnm >/dev/null 2>&1; then
{{ if eq .chezmoi.os "darwin" }}
    export FNM_PATH="${HOME}/Library/Application Support/fnm"
{{ else }}
    export FNM_PATH="${HOME}/.local/share/fnm"
{{ end }}

    if [ -d "$FNM_PATH" ]; then
        export PATH="${FNM_PATH}:$PATH"
    fi

    eval "$(fnm env --use-on-cd --shell bash)"
fi

# ============================================================================
# PYTHON (pyenv)
# ============================================================================
# Python version manager
if command -v pyenv >/dev/null 2>&1; then
    export PYENV_ROOT="$HOME/.pyenv"

    if [[ -d $PYENV_ROOT/bin ]]; then
        export PATH="$PYENV_ROOT/bin:$PATH"
    fi

    eval "$(pyenv init --path)"
    eval "$(pyenv init -)"

    # pyenv-virtualenv
    if command -v pyenv-virtualenv-init >/dev/null 2>&1; then
        eval "$(pyenv virtualenv-init -)"
    fi
fi

# ============================================================================
# RUST (Cargo)
# ============================================================================
# Rust package manager
if [ -f "$HOME/.cargo/env" ]; then
    source "$HOME/.cargo/env"
fi

# ============================================================================
# BUN
# ============================================================================
# Fast JavaScript runtime
if [ -d "$HOME/.bun" ]; then
    export BUN_INSTALL="$HOME/.bun"
    export PATH="$BUN_INSTALL/bin:$PATH"

    # Bun completions
    [ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
fi

# ============================================================================
# DENO
# ============================================================================
# Secure runtime for JavaScript and TypeScript
if [ -d "$HOME/.deno" ]; then
    export DENO_INSTALL="$HOME/.deno"
    export PATH="$DENO_INSTALL/bin:$PATH"

    # Deno completions
    [ -f "$HOME/.deno/env" ] && source "$HOME/.deno/env"
fi

# ============================================================================
# PNPM
# ============================================================================
# Performant npm
if command -v pnpm >/dev/null 2>&1; then
{{ if eq .chezmoi.os "darwin" }}
    export PNPM_HOME="${HOME}/Library/pnpm"
{{ else }}
    export PNPM_HOME="${HOME}/.local/share/pnpm"
{{ end }}

    case ":$PATH:" in
        *":$PNPM_HOME:"*) ;;
        *) export PATH="$PNPM_HOME:$PATH" ;;
    esac
fi

# ============================================================================
# RUBY (Homebrew)
# ============================================================================
{{ if eq .chezmoi.os "darwin" }}
if [ -d "${BREW_PREFIX}/opt/ruby/bin" ]; then
    export PATH="${BREW_PREFIX}/opt/ruby/bin:$PATH"

    # Add gem binaries to PATH
    if command -v gem >/dev/null 2>&1; then
        export PATH="$(gem environment gemdir)/bin:$PATH"
    fi
fi
{{ end }}

# ============================================================================
# LANDO
# ============================================================================
# Local development environment
if [ -d "$HOME/.lando/bin" ]; then
    export PATH="$HOME/.lando/bin:$PATH"
fi

# ============================================================================
# ATUIN
# ============================================================================
# Improved shell history
if command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init bash)"
fi

# ============================================================================
# DIRENV
# ============================================================================
# Per-directory environment variables
if command -v direnv >/dev/null 2>&1; then
    eval "$(direnv hook bash)"
fi

# ============================================================================
# GITHUB CLI
# ============================================================================
# GitHub CLI completions
if command -v gh >/dev/null 2>&1; then
    eval "$(gh completion -s bash)"
fi

# ============================================================================
# KUBECTL
# ============================================================================
# Kubernetes CLI completions
if command -v kubectl >/dev/null 2>&1; then
    source <(kubectl completion bash)
fi

# ============================================================================
# TERRAFORM
# ============================================================================
# Terraform completions
if command -v terraform >/dev/null 2>&1; then
    complete -o nospace -C $(which terraform) terraform
fi
