# UI
macos-titlebar-style = hidden
theme = Kanagawa Wave

# Fonts
font-family = "Berkeley Mono Variable"
font-family = "Symbols Nerd Font Mono"

# Berkeley Mono stylistic sets
font-feature = "ss01" # != and ===
font-feature = "ss02" # <= and >=
font-feature = "ss03" # -> and ~>
font-feature = "ss04" # <> and </>
font-feature = "liga" # //, ..., ||

font-size = 16
background-opacity = 0.98

# Clipboard
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# Keybinds delegated to shell/vim/fzf
keybind = ctrl+shift+v=ignore
keybind = ctrl+shift+s=ignore
keybind = ctrl+shift+t=ignore
keybind = alt+shift+p=ignore
keybind = cmd+enter=ignore

confirm-close-surface = false
