#!/usr/bin/env bash
# Install Zim ZSH framework

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

header() {
    echo -e "${BLUE}==>${NC} ${GREEN}$1${NC}"
}

notice() {
    echo -e "${YELLOW}==>${NC} $1"
}

error() {
    echo -e "${RED}Error:${NC} $1" >&2
}

# Check if ZSH is installed
if ! command -v zsh >/dev/null 2>&1; then
    error "ZSH is not installed. Please install ZSH first."
    exit 1
fi

# Set variables
ZDOTDIR="${HOME}/.config/zsh"
ZIM_HOME="${ZDOTDIR}/.zim"

header "Setting up Zim ZSH framework"

# Create ZSH config directory if it doesn't exist
if [[ ! -d "$ZDOTDIR" ]]; then
    notice "Creating ZSH config directory: $ZDOTDIR"
    mkdir -p "$ZDOTDIR"
fi

# Download zimfw if not already installed
if [[ ! -d "$ZIM_HOME" ]]; then
    notice "Downloading Zim framework..."
    curl -fsSL --create-dirs -o "${ZIM_HOME}/zimfw.zsh" \
        https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh

    if [[ $? -eq 0 ]]; then
        header "Zim framework downloaded successfully"
    else
        error "Failed to download Zim framework"
        exit 1
    fi
else
    notice "Zim framework already installed"
fi

# Install Zim modules (will be triggered by .zshrc on first load)
notice "Zim will auto-install modules on first ZSH launch"

# Set ZSH as default shell if not already
if [[ "$SHELL" != "$(which zsh)" ]]; then
    notice "ZSH is not your default shell"
    notice "To set ZSH as default, run: chsh -s $(which zsh)"
    notice "You may need to add $(which zsh) to /etc/shells first"
else
    header "ZSH is already your default shell"
fi

# Backup old Oh-My-Zsh installation
if [[ -d "${HOME}/.oh-my-zsh" ]]; then
    notice "Found Oh-My-Zsh installation"
    notice "Creating backup..."

    BACKUP_DIR="${HOME}/.oh-my-zsh.backup.$(date +%Y%m%d_%H%M%S)"
    mv "${HOME}/.oh-my-zsh" "$BACKUP_DIR"

    header "Oh-My-Zsh backed up to: $BACKUP_DIR"
    notice "You can safely delete this after confirming Zim works correctly"
fi

# Backup old .zshrc if it exists and is not a symlink
if [[ -f "${HOME}/.zshrc" && ! -L "${HOME}/.zshrc" ]]; then
    BACKUP_FILE="${HOME}/.zshrc.backup.$(date +%Y%m%d_%H%M%S)"
    cp "${HOME}/.zshrc" "$BACKUP_FILE"
    header "Backed up old .zshrc to: $BACKUP_FILE"
fi

echo ""
header "Zim setup complete!"
echo -e "${GREEN}✓${NC} Next steps:"
echo "  1. Open a new terminal or run: exec zsh"
echo "  2. Zim will auto-install modules on first launch"
echo "  3. Customize modules in ~/.config/zsh/.zimrc"
echo ""
echo -e "${YELLOW}Note:${NC} Your old ZSH config has been backed up"
