#!/usr/bin/env bash
# Install Homebrew packages from YAML configuration
# macOS only

{{- if ne .chezmoi.os "darwin" }}
# Not macOS, skip this script
exit 0
{{- end }}

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

header() {
    echo -e "${BLUE}==>${NC} ${GREEN}$1${NC}"
}

notice() {
    echo -e "${YELLOW}==>${NC} $1"
}

error() {
    echo -e "${RED}Error:${NC} $1" >&2
}

fatal() {
    error "$1"
    exit 1
}

retry() {
    local description="$1"
    shift

    local max_attempts=3
    local attempt

    for attempt in $(seq 1 "$max_attempts"); do
        if "$@"; then
            return 0
        fi

        if [[ "$attempt" -lt "$max_attempts" ]]; then
            notice "Retrying ${description} (${attempt}/${max_attempts})..."
            sleep 2
        fi
    done

    return 1
}

declare -a failed_items=()

record_failure() {
    failed_items+=("$1")
    error "$1"
}

# Check if Homebrew is installed
if ! command -v brew &>/dev/null; then
    fatal "Homebrew is not installed. Please run the pre-requisites script first."
fi

# Ensure yq is installed (required for parsing YAML)
if ! command -v yq &>/dev/null; then
    header "Installing yq (YAML parser)..."
    brew install yq
fi

PACKAGES_FILE="{{ .chezmoi.sourceDir }}/.chezmoidata/packages/darwin.yml"

if [[ ! -f "$PACKAGES_FILE" ]]; then
    fatal "Package file not found: $PACKAGES_FILE"
fi

if ! yq eval '.' "$PACKAGES_FILE" >/dev/null; then
    fatal "Invalid YAML in package file: $PACKAGES_FILE"
fi

brew_count=$(yq eval '.brews // [] | length' "$PACKAGES_FILE")
cask_count=$(yq eval '.casks // [] | length' "$PACKAGES_FILE")
font_count=$(yq eval '.fonts // [] | length' "$PACKAGES_FILE")
tap_count=$(yq eval '.taps // [] | length' "$PACKAGES_FILE")
mas_count=$(yq eval '.mas_apps // [] | length' "$PACKAGES_FILE")

header "Package preflight"
notice "Detected ${tap_count} taps"
notice "Detected ${brew_count} formulas"
notice "Detected ${cask_count} casks"
notice "Detected ${font_count} fonts"
notice "Detected ${mas_count} App Store apps"

if [[ "$brew_count" -eq 0 && "$cask_count" -eq 0 && "$font_count" -eq 0 && "$mas_count" -eq 0 ]]; then
    notice "No install targets found in darwin.yml"
fi

header "Processing Homebrew packages from darwin.yml"

# ============================================================================
# REMOVAL SECTION - Remove unwanted packages first
# ============================================================================
notice "Checking for packages to remove..."

# Remove brews
remove_brews=$(yq eval '.remove.brews[]?' "$PACKAGES_FILE")
if [[ -n "$remove_brews" ]]; then
    while IFS= read -r formula; do
        if [[ -n "$formula" && "$formula" != "null" ]]; then
            if brew list "$formula" &>/dev/null; then
                header "Removing formula: $formula"
                retry "remove formula $formula" brew uninstall "$formula" || record_failure "Failed to remove formula: $formula"
            else
                notice "Not installed (skip): $formula"
            fi
        fi
    done <<< "$remove_brews"
fi

# Remove casks
remove_casks=$(yq eval '.remove.casks[]?' "$PACKAGES_FILE")
if [[ -n "$remove_casks" ]]; then
    while IFS= read -r cask; do
        if [[ -n "$cask" && "$cask" != "null" ]]; then
            if brew list --cask "$cask" &>/dev/null; then
                header "Removing cask: $cask"
                retry "remove cask $cask" brew uninstall --cask "$cask" || record_failure "Failed to remove cask: $cask"
            else
                notice "Not installed (skip): $cask"
            fi
        fi
    done <<< "$remove_casks"
fi

# Remove fonts
remove_fonts=$(yq eval '.remove.fonts[]?' "$PACKAGES_FILE")
if [[ -n "$remove_fonts" ]]; then
    while IFS= read -r font; do
        if [[ -n "$font" && "$font" != "null" ]]; then
            if brew list --cask "$font" &>/dev/null; then
                header "Removing font: $font"
                retry "remove font $font" brew uninstall --cask "$font" || record_failure "Failed to remove font: $font"
            else
                notice "Not installed (skip): $font"
            fi
        fi
    done <<< "$remove_fonts"
fi

# ============================================================================
# INSTALLATION SECTION
# ============================================================================

# Parse YAML and install taps
notice "Adding Homebrew taps..."
taps=$(yq eval '.taps[]?' "$PACKAGES_FILE")
if [[ -n "$taps" ]]; then
    while IFS= read -r tap; do
        if [[ -n "$tap" && "$tap" != "null" ]]; then
            header "Adding tap: $tap"
            retry "add tap $tap" brew tap "$tap" || record_failure "Failed to add tap: $tap"
        fi
    done <<< "$taps"
fi

# Install formulas
notice "Installing Homebrew formulas..."
brews=$(yq eval '.brews[]?' "$PACKAGES_FILE")
if [[ -n "$brews" ]]; then
    to_install=()
    while IFS= read -r formula; do
        if [[ -n "$formula" && "$formula" != "null" ]]; then
            if brew list "$formula" &>/dev/null; then
                notice "Already installed: $formula"
            else
                to_install+=("$formula")
            fi
        fi
    done <<< "$brews"

    if [[ ${#to_install[@]} -gt 0 ]]; then
        header "Installing ${#to_install[@]} formulas..."

        if ! retry "install formula batch" brew install "${to_install[@]}"; then
            notice "Batch formula install failed, retrying individually..."
            for formula in "${to_install[@]}"; do
                if brew list "$formula" &>/dev/null; then
                    continue
                fi

                header "Installing: $formula"
                retry "install formula $formula" brew install "$formula" || record_failure "Failed to install formula: $formula"
            done
        fi
    fi
fi

# Install casks
notice "Installing Homebrew casks..."
casks=$(yq eval '.casks[]?' "$PACKAGES_FILE")
if [[ -n "$casks" ]]; then
    while IFS= read -r cask; do
        if [[ -n "$cask" && "$cask" != "null" ]]; then
            if brew list --cask "$cask" &>/dev/null; then
                notice "Already installed: $cask"
            else
                header "Installing cask: $cask"
                retry "install cask $cask" brew install --cask "$cask" || record_failure "Failed to install cask: $cask"
            fi
        fi
    done <<< "$casks"
fi

# Install fonts
notice "Installing fonts..."
fonts=$(yq eval '.fonts[]?' "$PACKAGES_FILE")
if [[ -n "$fonts" ]]; then
    while IFS= read -r font; do
        if [[ -n "$font" && "$font" != "null" ]]; then
            if brew list --cask "$font" &>/dev/null; then
                notice "Already installed: $font"
            else
                header "Installing font: $font"
                retry "install font $font" brew install --cask "$font" || record_failure "Failed to install font: $font"
            fi
        fi
    done <<< "$fonts"
fi

# Install Mac App Store apps (if mas is available)
if command -v mas &>/dev/null; then
    notice "Installing Mac App Store apps..."
    if [[ "$mas_count" -gt 0 ]]; then
        for ((i=0; i<mas_count; i++)); do
            app_id=$(yq eval ".mas_apps[$i].id" "$PACKAGES_FILE")
            app_name=$(yq eval ".mas_apps[$i].name" "$PACKAGES_FILE")
            if [[ -n "$app_id" && "$app_id" != "null" ]]; then
                if mas list | grep -q "^$app_id"; then
                    notice "Already installed: $app_name ($app_id)"
                else
                    header "Installing from App Store: $app_name ($app_id)"
                    retry "install App Store app $app_name" mas install "$app_id" || record_failure "Failed to install App Store app: $app_name ($app_id)"
                fi
            fi
        done
    fi
fi

header "Package installation complete!"

# Cleanup
notice "Running brew cleanup..."
brew cleanup

if [[ ${#failed_items[@]} -gt 0 ]]; then
    error "Completed with ${#failed_items[@]} failure(s):"
    for failed_item in "${failed_items[@]}"; do
        error " - ${failed_item}"
    done
    exit 1
fi

echo -e "${GREEN}✓${NC} All packages installed successfully!"
