#!/usr/bin/env bash
# Install 1Password CLI (and optionally desktop app) on Linux
# VMs only get CLI, desktop systems get both

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

header() {
    echo -e "${BLUE}==>${NC} ${GREEN}$1${NC}"
}

notice() {
    echo -e "${YELLOW}==>${NC} $1"
}

error() {
    echo -e "${RED}Error:${NC} $1" >&2
}

# Check if 1Password CLI is already installed
if command -v op &>/dev/null; then
    notice "1Password CLI is already installed. Skipping"
    exit 0
fi

{{ if .is_vm }}
# ============================================================================
# VM INSTALLATION - CLI ONLY
# ============================================================================
notice "VM detected - installing 1Password CLI only"

if command -v apt &>/dev/null; then
    header "Installing 1Password CLI on Ubuntu/Debian VM..."

    # Add the key for the 1Password apt repository
    curl -sS https://downloads.1password.com/linux/keys/1password.asc | \
        sudo gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg

    # Add the 1Password apt repository
    echo 'deb [arch=amd64 signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/amd64 stable main' | \
        sudo tee /etc/apt/sources.list.d/1password.list

    # Add the debsig-verify policy
    sudo mkdir -p /etc/debsig/policies/AC2D62742012EA22/
    curl -sS https://downloads.1password.com/linux/debian/debsig/1password.pol | \
        sudo tee /etc/debsig/policies/AC2D62742012EA22/1password.pol
    sudo mkdir -p /usr/share/debsig/keyrings/AC2D62742012EA22
    curl -sS https://downloads.1password.com/linux/keys/1password.asc | \
        sudo gpg --dearmor --output /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg

    # Update package list and install 1Password CLI only
    sudo apt update
    sudo apt install -y 1password-cli

    header "1Password CLI installed successfully"

elif command -v pacman &>/dev/null; then
    header "Installing 1Password CLI on Arch Linux VM..."

    # Use paru or yay for AUR packages
    if command -v paru &>/dev/null; then
        paru -S --noconfirm 1password-cli
    elif command -v yay &>/dev/null; then
        yay -S --noconfirm 1password-cli
    else
        error "No AUR helper found. Please install paru or yay first."
        exit 1
    fi

    header "1Password CLI installed successfully"
else
    error "Unsupported Linux distribution"
    notice "Please visit https://developer.1password.com/docs/cli/get-started/ for manual installation"
    exit 1
fi

{{ else }}
# ============================================================================
# DESKTOP INSTALLATION - FULL APP + CLI
# ============================================================================
notice "Desktop system detected - installing full 1Password app"

if command -v apt &>/dev/null; then
    header "Installing 1Password on Ubuntu/Debian..."

    # Add the key for the 1Password apt repository
    curl -sS https://downloads.1password.com/linux/keys/1password.asc | \
        sudo gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg

    # Add the 1Password apt repository
    echo 'deb [arch=amd64 signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/amd64 stable main' | \
        sudo tee /etc/apt/sources.list.d/1password.list

    # Add the debsig-verify policy
    sudo mkdir -p /etc/debsig/policies/AC2D62742012EA22/
    curl -sS https://downloads.1password.com/linux/debian/debsig/1password.pol | \
        sudo tee /etc/debsig/policies/AC2D62742012EA22/1password.pol
    sudo mkdir -p /usr/share/debsig/keyrings/AC2D62742012EA22
    curl -sS https://downloads.1password.com/linux/keys/1password.asc | \
        sudo gpg --dearmor --output /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg

    # Update package list and install 1Password (includes CLI)
    sudo apt update
    sudo apt install -y 1password 1password-cli

    header "1Password installed successfully"

elif command -v pacman &>/dev/null; then
    header "Installing 1Password on Arch Linux..."

    # Use paru or yay for AUR packages
    if command -v paru &>/dev/null; then
        paru -S --noconfirm 1password 1password-cli
    elif command -v yay &>/dev/null; then
        yay -S --noconfirm 1password 1password-cli
    else
        error "No AUR helper found. Please install paru or yay first."
        exit 1
    fi

    header "1Password installed successfully"
else
    error "Unsupported Linux distribution"
    notice "Please visit https://1password.com/downloads/linux/ for manual installation"
    exit 1
fi
{{ end }}

echo -e "${GREEN}✓${NC} 1Password setup complete!"
