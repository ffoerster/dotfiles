#!/usr/bin/env bash
# Install Debian/Ubuntu packages from YAML configuration
# Debian/Ubuntu only

{{- if not (and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id") (or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu"))) }}
# Not Debian/Ubuntu, skip this script
exit 0
{{- end }}

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

header() {
    echo -e "${BLUE}==>${NC} ${GREEN}$1${NC}"
}

notice() {
    echo -e "${YELLOW}==>${NC} $1"
}

error() {
    echo -e "${RED}Error:${NC} $1" >&2
}

PACKAGES_FILE="{{ .chezmoi.sourceDir }}/.chezmoidata/packages/linux/debian.yml"

if [[ ! -f "$PACKAGES_FILE" ]]; then
    error "Package file not found: $PACKAGES_FILE"
    exit 1
fi

# Check if yq is available (needed to parse YAML)
if ! command -v yq &>/dev/null; then
    notice "yq not found, installing..."
    YQ_VERSION="v4.35.1"
    case "$(uname -m)" in
        x86_64)
            YQ_BINARY="yq_linux_amd64"
            ;;
        aarch64|arm64)
            YQ_BINARY="yq_linux_arm64"
            ;;
        *)
            error "Unsupported architecture for yq installation: $(uname -m)"
            exit 1
            ;;
    esac
    sudo wget -qO /usr/local/bin/yq "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/${YQ_BINARY}"
    sudo chmod +x /usr/local/bin/yq
fi

if ! yq eval '.' "$PACKAGES_FILE" >/dev/null; then
    error "Invalid YAML in package file: $PACKAGES_FILE"
    exit 1
fi

remove_count=$(yq eval '.remove.apt // [] | length' "$PACKAGES_FILE")
apt_count=$(yq eval '.apt // [] | length' "$PACKAGES_FILE")
external_count=$(yq eval '.external // [] | length' "$PACKAGES_FILE")
vm_exclude_count=$(yq eval '.vm_exclude // [] | length' "$PACKAGES_FILE")
desktop_count=$(yq eval '.desktop // [] | length' "$PACKAGES_FILE")

header "Package preflight"
notice "Detected ${remove_count} removable APT packages"
notice "Detected ${apt_count} APT packages"
notice "Detected ${external_count} external packages"
notice "Detected ${vm_exclude_count} VM exclude packages"
notice "Detected ${desktop_count} desktop packages"

header "Processing Debian/Ubuntu packages from debian.yml"

# ============================================================================
# REMOVAL SECTION - Remove unwanted packages first
# ============================================================================
notice "Checking for packages to remove..."

# Remove APT packages
remove_apt=$(yq eval '.remove.apt[]?' "$PACKAGES_FILE")
if [[ -n "$remove_apt" ]]; then
    to_remove=()
    while IFS= read -r pkg; do
        if [[ -n "$pkg" && "$pkg" != "null" ]]; then
            if dpkg -l "$pkg" 2>/dev/null | grep -q "^ii"; then
                to_remove+=("$pkg")
            else
                notice "Not installed (skip): $pkg"
            fi
        fi
    done <<< "$remove_apt"

    if [[ ${#to_remove[@]} -gt 0 ]]; then
        header "Removing ${#to_remove[@]} APT packages..."
        sudo apt remove -y "${to_remove[@]}" || error "Failed to remove some packages"
        sudo apt autoremove -y
    fi
fi

# ============================================================================
# INSTALLATION SECTION
# ============================================================================

# Update package database
header "Updating package list..."
sudo apt update

# Install APT packages
notice "Installing APT packages..."
apt_pkgs=$(yq eval '.apt[]?' "$PACKAGES_FILE")
if [[ -n "$apt_pkgs" ]]; then
{{ if .is_vm }}
    # On VMs, check for packages to exclude
    vm_exclude=$(yq eval '.vm_exclude[]?' "$PACKAGES_FILE")
    exclude_list=()
    while IFS= read -r pkg; do
        if [[ -n "$pkg" && "$pkg" != "null" ]]; then
            exclude_list+=("$pkg")
        fi
    done <<< "$vm_exclude"
{{ end }}

    to_install=()
    while IFS= read -r pkg; do
        if [[ -n "$pkg" && "$pkg" != "null" ]]; then
{{ if .is_vm }}
            # Skip if in VM exclude list
            skip=false
            for exclude_pkg in "${exclude_list[@]}"; do
                if [[ "$pkg" == "$exclude_pkg" ]]; then
                    notice "Skipping (VM exclude): $pkg"
                    skip=true
                    break
                fi
            done
            [[ "$skip" == true ]] && continue
{{ end }}

            if dpkg -l "$pkg" 2>/dev/null | grep -q "^ii"; then
                notice "Already installed: $pkg"
            else
                to_install+=("$pkg")
            fi
        fi
    done <<< "$apt_pkgs"

    if [[ ${#to_install[@]} -gt 0 ]]; then
        header "Installing ${#to_install[@]} APT packages..."
        sudo apt install -y "${to_install[@]}" || error "Failed to install some packages"
    fi
fi

# Install external packages (requires special handling)
notice "Installing external packages..."
if [[ "$external_count" -gt 0 ]]; then
    for ((i=0; i<external_count; i++)); do
        pkg_name=$(yq eval ".external[$i].name" "$PACKAGES_FILE")
        pkg_method=$(yq eval ".external[$i].method" "$PACKAGES_FILE")

        if [[ -n "$pkg_name" && "$pkg_name" != "null" ]]; then
            if command -v "$pkg_name" &>/dev/null; then
                notice "Already installed: $pkg_name"
            else
                header "Installing external package: $pkg_name"
                case "$pkg_method" in
                    "cargo install "*)
                        # Install via Cargo
                        if ! command -v cargo &>/dev/null; then
                            notice "Installing Rust toolchain for cargo..."
                            curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
                            source "$HOME/.cargo/env"
                        fi
                        eval "$pkg_method" || error "Failed to install $pkg_name via cargo"
                        ;;
                    "script")
                        # Custom installation method
                        case "$pkg_name" in
                            "1password-cli")
                                notice "1password-cli should be installed via pre-requisites script"
                                ;;
                            *)
                                notice "No installation method for $pkg_name"
                                ;;
                        esac
                        ;;
                    *)
                        notice "Unknown installation method for $pkg_name: $pkg_method"
                        ;;
                esac
            fi
        fi
    done
fi

{{ if not .is_vm }}
# Install desktop packages (only on non-VM systems)
notice "Installing desktop packages..."
desktop_pkgs=$(yq eval '.desktop[]?' "$PACKAGES_FILE")
if [[ -n "$desktop_pkgs" ]]; then
    to_install=()
    while IFS= read -r pkg; do
        if [[ -n "$pkg" && "$pkg" != "null" ]]; then
            if dpkg -l "$pkg" 2>/dev/null | grep -q "^ii"; then
                notice "Already installed: $pkg"
            else
                to_install+=("$pkg")
            fi
        fi
    done <<< "$desktop_pkgs"

    if [[ ${#to_install[@]} -gt 0 ]]; then
        header "Installing ${#to_install[@]} desktop packages..."
        sudo apt install -y "${to_install[@]}" || error "Failed to install some desktop packages"
    fi
fi
{{ end }}

# Create symlinks for Debian-specific binary names
notice "Creating symlinks for Debian-specific binaries..."
if command -v fdfind &>/dev/null && ! command -v fd &>/dev/null; then
    sudo ln -sf "$(which fdfind)" /usr/local/bin/fd
    notice "Created symlink: fd -> fdfind"
fi

if command -v batcat &>/dev/null && ! command -v bat &>/dev/null; then
    sudo ln -sf "$(which batcat)" /usr/local/bin/bat
    notice "Created symlink: bat -> batcat"
fi

header "Package installation complete!"

# Cleanup
notice "Cleaning up..."
sudo apt autoremove -y
sudo apt autoclean

echo -e "${GREEN}✓${NC} All packages installed successfully!"
