#!/usr/bin/env bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

header() {
    echo -e "${BLUE}==>${NC} ${GREEN}$1${NC}"
}

notice() {
    echo -e "${YELLOW}==>${NC} $1"
}

error() {
    echo -e "${RED}Error:${NC} $1" >&2
}

{{ if eq .chezmoi.os "darwin" }}

if [[ ! $(command -v brew) ]]; then
    header "🍺  Installing Homebrew"

    if ! /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
        error "Failed to install Homebrew"
        exit 1
    fi

    notice "Homebrew installation completed"
fi

if [[ -e "/opt/homebrew/bin/brew" && ! $(command -v brew) ]]; then
    notice "Adding Homebrew to your PATH"
    echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >>/Users/ffoerster/.zprofile
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Verify Homebrew is available
if ! command -v brew &>/dev/null; then
    error "Homebrew installation completed but 'brew' command not found in PATH"
    error "You may need to restart your shell or run: eval \"\$(/opt/homebrew/bin/brew shellenv)\""
    exit 1
fi

header "✓ Homebrew is ready"

{{ end }}

{{ if eq .chezmoi.os "linux" }}

install=false

# Declare a regular array for the package names
declare -a packages=(
    "curl"
    "unzip"
    "wget"
)

to_install=()

# Loop through the commands to check if they're installed
for cmd in "${packages[@]}"; do
    if ! command -v "${cmd}" &>/dev/null; then
        install=true
        to_install+=("${cmd}")
    fi
done

# Install missing packages
if ${install}; then
    header "Updating package list"
    sudo apt update

    for pkg in "${to_install[@]}"; do
        header "Installing ${pkg}"
        sudo apt install -y "${pkg}"
    done
fi

{{ end }}

