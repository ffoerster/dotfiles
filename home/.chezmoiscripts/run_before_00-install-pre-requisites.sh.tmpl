#!/usr/bin/env bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

header() {
    echo -e "${BLUE}==>${NC} ${GREEN}$1${NC}"
}

notice() {
    echo -e "${YELLOW}==>${NC} $1"
}

error() {
    echo -e "${RED}Error:${NC} $1" >&2
}

{{ if eq .chezmoi.os "darwin" }}

if [[ ! $(command -v brew) ]]; then
    header "🍺  Installing Homebrew"

    if ! /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
        error "Failed to install Homebrew"
        exit 1
    fi

    notice "Homebrew installation completed"
fi

if [[ -e "/opt/homebrew/bin/brew" && ! $(command -v brew) ]]; then
    notice "Adding Homebrew to your PATH"
    echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >>/Users/ffoerster/.zprofile
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Verify Homebrew is available
if ! command -v brew &>/dev/null; then
    error "Homebrew installation completed but 'brew' command not found in PATH"
    error "You may need to restart your shell or run: eval \"\$(/opt/homebrew/bin/brew shellenv)\""
    exit 1
fi

header "✓ Homebrew is ready"

{{ end }}

{{ if eq .chezmoi.os "linux" }}

{{- if and (hasKey .chezmoi.osRelease "id") (eq .chezmoi.osRelease.id "arch") }}

# ============================================================================
# ARCH LINUX PRE-REQUISITES
# ============================================================================

install=false

# Declare packages needed for Arch Linux
declare -a packages=(
    "curl"
    "wget"
    "unzip"
    "git"
    "base-devel"  # Required for building AUR packages
)

to_install=()

# Check which packages are missing
for pkg in "${packages[@]}"; do
    if ! pacman -Q "${pkg}" &>/dev/null; then
        install=true
        to_install+=("${pkg}")
    fi
done

# Install missing packages with pacman
if ${install}; then
    header "Installing pre-requisite packages with pacman"
    sudo pacman -S --needed --noconfirm "${to_install[@]}"
fi

# Install paru (AUR helper) if not present
if ! command -v paru &>/dev/null; then
    header "Installing paru (AUR helper)"

    # Create temporary directory for building paru
    PARU_BUILD_DIR=$(mktemp -d)

    notice "Cloning paru repository..."
    git clone https://aur.archlinux.org/paru.git "$PARU_BUILD_DIR"

    cd "$PARU_BUILD_DIR"

    notice "Building and installing paru..."
    makepkg -si --noconfirm

    cd -
    rm -rf "$PARU_BUILD_DIR"

    if command -v paru &>/dev/null; then
        header "✓ paru installed successfully"
    else
        error "Failed to install paru"
        notice "You can manually install an AUR helper later"
    fi
fi

{{- else }}

# ============================================================================
# DEBIAN/UBUNTU PRE-REQUISITES
# ============================================================================

install=false

# Declare a regular array for the package names
declare -a packages=(
    "curl"
    "unzip"
    "wget"
)

to_install=()

# Loop through the commands to check if they're installed
for cmd in "${packages[@]}"; do
    if ! command -v "${cmd}" &>/dev/null; then
        install=true
        to_install+=("${cmd}")
    fi
done

# Install missing packages
if ${install}; then
    header "Updating package list"
    sudo apt update

    for pkg in "${to_install[@]}"; do
        header "Installing ${pkg}"
        sudo apt install -y "${pkg}"
    done
fi

{{- end }}

{{ end }}

